        },
        "zh-Hans-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法自动提交工作区文件。已保存的资源和文件变化已保留，指定文件可能已暂存。请检查 Git 身份、签名配置和仓库状态后重试。%1$@"
          }
        }
      }
    },
