          }
        },
        "zh-Hans-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成工作区改动恢复。stash %1$@ 和已完成的工作区提交均已保留。请检查工作树及暂存区冲突，再使用 git stash apply --index %2$@ 手动恢复。%3$@"
          }
        }
      }
    },
